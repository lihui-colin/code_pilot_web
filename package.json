{
  "name": "codepilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codepilot-server": "scripts/codepilot-server"
  },
  "files": [
    "dist",
    "src",
    "scripts/codepilot-server",
    "scripts/service-runtime.mjs",
    "config.example.json",
    "README.md"
  ],
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.server.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\" && vite build",
    "build:web": "vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "npm run build:web && concurrently --kill-others --passthrough-arguments \"npm run dev:web\" \"npm run dev:server -- {@}\" --",
    "dev:server": "tsx watch src/codepilot-server.ts --config config.json",
    "dev:web": "vite build --watch",
    "probe:mvp0": "node scripts/probe-mvp0.mjs",
    "probe:mvp1": "node scripts/probe-mvp1.mjs",
    "probe:zellij-web-attach": "node scripts/probe-zellij-web-attach.mjs",
    "deploy:pi-web-jmf": "bash scripts/deploy-pi-web-jmfederico.sh",
    "service:start": "node dist/cli.js start",
    "service:restart": "node dist/cli.js restart",
    "service:stop": "node dist/cli.js stop",
    "start": "node dist/cli.js",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.1",
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/reply-from": "^12.6.4",
    "@fastify/static": "^10.1.2",
    "@youtyan/code-viewer": "0.10.0",
    "fastify": "^5.4.0",
    "pino": "^9.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.4",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
