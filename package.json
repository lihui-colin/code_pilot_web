{
  "name": "terminal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.server.json && vite build",
    "build:web": "vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "npm run build:web && concurrently --kill-others --passthrough-arguments \"npm run dev:web\" \"npm run dev:server -- {@}\" --",
    "dev:server": "tsx watch src/server.ts --config config.json",
    "dev:web": "vite build --watch",
    "postinstall": "node src/services/zellij-installer.ts --install-only",
    "probe:mvp0": "node scripts/probe-mvp0.mjs",
    "probe:mvp1": "node scripts/probe-mvp1.mjs",
    "probe:zellij-web-attach": "node scripts/probe-zellij-web-attach.mjs",
    "service:start": "scripts/start-service.sh",
    "service:restart": "scripts/restart-service.sh",
    "service:stop": "scripts/stop-service.sh",
    "start": "node dist/server.js --config config.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/reply-from": "^12.6.4",
    "@fastify/static": "^10.1.2",
    "@youtyan/code-viewer": "0.10.0",
    "fastify": "^5.4.0",
    "pino": "^9.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.4",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
